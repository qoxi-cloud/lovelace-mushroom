{
 "views": [
  {
   "title": "Home",
   "path": "home",
   "type": "sections",
   "max_columns": 3,
   "icon": "mdi:home-variant",
   "sections": [
    {
     "type": "grid",
     "cards": [
      {
       "type": "heading",
       "heading": "Home",
       "heading_style": "title",
       "icon": "mdi:home-variant"
      },
      {
       "type": "custom:mushroom-chips-card",
       "alignment": "start",
       "chips": [
        {
         "type": "weather",
         "entity": "weather.forecast_home",
         "show_conditions": true,
         "show_temperature": true
        },
        {
         "type": "entity",
         "entity": "person.ihor",
         "icon_color": "blue"
        },
        {
         "type": "entity",
         "entity": "person.ipayk24",
         "icon_color": "blue"
        },
        {
         "type": "template",
         "entity": "alarm_control_panel.server_hub_2_plus_jeweller",
         "icon": "mdi:shield-home",
         "icon_color": "{{ 'red' if not is_state(entity,'disarmed') else 'disabled' }}",
         "content": "{{ states(entity) | replace('_',' ') | capitalize }}",
         "tap_action": {
          "action": "more-info"
         }
        },
        {
         "type": "template",
         "icon": "mdi:lightbulb-group",
         "icon_color": "{{ 'amber' if states.light | selectattr('state','eq','on') | list | count > 0 else 'disabled' }}",
         "content": "{{ states.light | selectattr('state','eq','on') | list | count }} on",
         "tap_action": {
          "action": "call-service",
          "perform_action": "light.turn_off",
          "target": {
           "entity_id": "all"
          }
         }
        },
        {
         "type": "template",
         "icon": "mdi:radiator",
         "icon_color": "{{ 'orange' if is_state('sensor.wiser_heathub_wiserheat06724f_wiser_heating','on') else 'disabled' }}",
         "content": "Heating",
         "entity": "sensor.wiser_heathub_wiserheat06724f_wiser_heating",
         "tap_action": {
          "action": "more-info"
         }
        },
        {
         "type": "template",
         "icon": "mdi:snowflake",
         "icon_color": "{{ 'light-blue' if states.climate | selectattr('entity_id','search','gree') | rejectattr('state','eq','off') | list | count > 0 else 'disabled' }}",
         "content": "AC {{ states.climate | selectattr('entity_id','search','gree') | rejectattr('state','eq','off') | list | count }}"
        }
       ]
      },
      {
       "type": "grid",
       "columns": 3,
       "square": false,
       "cards": [
        {
         "type": "custom:mushroom-template-card",
         "primary": "Good night",
         "secondary": "",
         "icon": "mdi:weather-night",
         "icon_color": "indigo",
         "layout": "vertical",
         "fill_container": true,
         "tap_action": {
          "action": "perform-action",
          "perform_action": "script.good_night"
         }
        },
        {
         "type": "custom:mushroom-template-card",
         "primary": "Leaving",
         "secondary": "",
         "icon": "mdi:home-export-outline",
         "icon_color": "teal",
         "layout": "vertical",
         "fill_container": true,
         "tap_action": {
          "action": "perform-action",
          "perform_action": "script.leaving_home"
         }
        },
        {
         "type": "custom:mushroom-template-card",
         "primary": "All off",
         "secondary": "",
         "icon": "mdi:power",
         "icon_color": "red",
         "layout": "vertical",
         "fill_container": true,
         "tap_action": {
          "action": "perform-action",
          "perform_action": "script.all_off"
         }
        }
       ]
      }
     ]
    },
